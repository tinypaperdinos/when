{
  "name": "server",
  "private": true,
  "version": "0.0.0",
  "main": "src/routers/app-router.ts",
  "types": "src/routers/app-router.ts",
  "scripts": {
    "dev": "tsx --env-file=.env watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "migrate": "prisma migrate dev",
    "postinstall": "prisma generate"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "~6.19.3",
    "@trpc/server": "^11.18.0",
    "express": "^5.2.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^26.1.1",
    "prisma": "~6.19.3",
    "tsx": "^4.23.1",
    "vitest": "^4.1.10"
  }
}
